{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trueeval.fixture_judge_verdict.v0.1"
    },
    "judge_job_id": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "judge_job_id",
    "score",
    "confidence",
    "rationale"
  ],
  "additionalProperties": false
}
