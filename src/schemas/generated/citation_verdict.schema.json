{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trueeval.citation_verdict.v0.1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "citation_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supported",
        "partially_supported",
        "contradicted",
        "irrelevant",
        "insufficient_evidence",
        "evidence_unavailable"
      ]
    },
    "score": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifact_id",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "citation_id",
    "verdict",
    "score",
    "confidence",
    "evidence_spans",
    "rationale",
    "flags"
  ],
  "additionalProperties": false
}
