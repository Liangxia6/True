{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trueeval.sut.v0.1"
    },
    "sut_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "api",
        "process",
        "manual",
        "fake"
      ]
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "account_tier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "research_mode": {
          "type": "boolean"
        },
        "short_fact": {
          "type": "boolean"
        },
        "long_form": {
          "type": "boolean"
        },
        "visible_citations": {
          "type": "boolean"
        },
        "citation_urls": {
          "type": "string",
          "enum": [
            "full",
            "visible_only",
            "none"
          ]
        },
        "file_output": {
          "type": "boolean"
        }
      },
      "required": [
        "research_mode",
        "short_fact",
        "long_form",
        "visible_citations",
        "citation_urls",
        "file_output"
      ],
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "max_workers": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "account_scoped": {
          "type": "boolean"
        }
      },
      "required": [
        "max_workers",
        "account_scoped"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sut_id",
    "provider",
    "product",
    "channel",
    "adapter_id",
    "adapter_version",
    "account_tier",
    "capabilities",
    "concurrency"
  ],
  "additionalProperties": false
}
