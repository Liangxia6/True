{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trueeval.long_form_judge_verdict.v0.1"
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "insight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "instruction_following": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clarity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "factual_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "uncertain"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim",
          "verdict",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "coverage",
    "insight",
    "instruction_following",
    "clarity",
    "factual_claims",
    "confidence",
    "rationale"
  ],
  "additionalProperties": false
}
