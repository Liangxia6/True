{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trueeval.task.v0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "const": "research"
    },
    "track": {
      "type": "string",
      "enum": [
        "short_fact",
        "long_form"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "artifact_id",
              "kind",
              "uri",
              "media_type",
              "sha256",
              "size_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "prompt",
        "language",
        "as_of",
        "attachments"
      ],
      "additionalProperties": false
    },
    "expected_output": {
      "type": "object",
      "properties": {
        "answer_form": {
          "type": "string",
          "enum": [
            "short_text",
            "list",
            "structured_json",
            "report"
          ]
        },
        "citation_required": {
          "type": "boolean"
        }
      },
      "required": [
        "answer_form",
        "citation_required"
      ],
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "internet_required": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timeout_seconds",
        "internet_required",
        "max_attempts"
      ],
      "additionalProperties": false
    },
    "evaluation_profile": {
      "type": "object",
      "properties": {
        "official_grader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "const": "citation_reliability"
          }
        }
      },
      "required": [
        "official_grader",
        "overlays"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "benchmark_id",
    "split",
    "domain",
    "track",
    "input",
    "expected_output",
    "required_capabilities",
    "constraints",
    "evaluation_profile",
    "provenance"
  ],
  "additionalProperties": false
}
