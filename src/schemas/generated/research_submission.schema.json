{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trueeval.research_submission.v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "enum": [
        "short_fact",
        "long_form"
      ]
    },
    "final_answer": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "section_id",
          "heading",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_span": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "importance": {
            "type": "string",
            "enum": [
              "major",
              "minor"
            ]
          },
          "verifiability": {
            "type": "string",
            "enum": [
              "externally_verifiable",
              "opinion",
              "non_verifiable"
            ]
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "claim_id",
          "text",
          "source_span",
          "importance",
          "verifiability",
          "citation_ids"
        ],
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation_id": {
            "type": "string",
            "minLength": 1
          },
          "display_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "visible_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolved_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "quoted_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "collection_status": {
            "type": "string",
            "enum": [
              "resolved",
              "visible_only",
              "product_absent",
              "adapter_failed",
              "unresolvable"
            ]
          }
        },
        "required": [
          "citation_id",
          "display_text",
          "visible_url",
          "resolved_url",
          "quoted_text",
          "claim_ids",
          "collection_status"
        ],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "uri",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    },
    "normalization": {
      "type": "object",
      "properties": {
        "normalizer_id": {
          "type": "string",
          "minLength": 1
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "citation_collection_status": {
          "type": "string",
          "enum": [
            "collected",
            "product_absent",
            "adapter_failed",
            "not_observable"
          ]
        }
      },
      "required": [
        "normalizer_id",
        "normalizer_version",
        "source_artifact_sha256",
        "citation_collection_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "attempt_id",
    "task_id",
    "track",
    "final_answer",
    "sections",
    "claims",
    "citations",
    "attachments",
    "normalization"
  ],
  "additionalProperties": false
}
